# frozen_string_literal: true

class CreateDials < ActiveRecord::Migration[<%= ActiveRecord::Migration.current_version %>]
  def change
    # One table, append-only. Every adjustment and every reset inserts a row;
    # nothing is ever updated or deleted. The newest row for a (key, scope)
    # pair is the current value, and a NULL value is a tombstone meaning
    # "no override here".
    #
    # So this table is the change log and the state at the same time, and its
    # row count is the version counter each process watches to notice writes
    # made by another one.
    create_table :dials do |t|
      t.string   :key,   null: false
      t.string   :scope, null: false, default: "{}" # canonical JSON; "{}" is global
      t.text     :value                             # JSON-encoded; NULL means cleared
      t.string   :actor_type
      t.string   :actor_id
      t.string   :actor_label
      t.datetime :created_at, null: false
    end

    # Serves both reads: the newest row per (key, scope), and one dial's
    # history. There is nothing else to query.
    add_index :dials, [:key, :scope, :id]
  end
end
