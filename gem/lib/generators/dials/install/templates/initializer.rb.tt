# frozen_string_literal: true

Dials.define do
  # A dial needs a key, a default, and a type. Anything that answers `===` is
  # a type: a class, a range, a regexp, an Array of allowed values, or one of
  # Literal's types, which are available inside this block.
  #
  #   dial :signups_enabled, default: true, type: _Boolean
  #
  #   dial :checkout_fee_bps, default: 250, type: _Integer(1..10_000),
  #        unit: "bps",
  #        description: "Fee charged at checkout.",
  #        dimensions: { market: %w[KE NG BD] }
  #
  # Declaring `dimensions:` is the arming gate: a dial without them is
  # global-only by construction, and adding one belongs in the same change as
  # the code that reads the varied value.
end

Dials.configure do |config|
  # Seconds before this process checks for writes made by another one.
  config.cache_ttl = 5.0

  # How an actor is labelled in the change log.
  # config.actor_label = ->(actor) { actor.email }

  # Who to attribute a write to when the caller passes no `actor:`. Leave it
  # unset and every write must name one.
  # config.default_actor = -> { ENV.fetch("USER", "console") }
end
